# ==============================================================================
# ContractIQ – Enterprise Legal Contract Intelligence Platform
# Root Environment Configuration Template (Copy to .env for Docker/Production)
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
PROJECT_NAME="ContractIQ Legal Intelligence Platform"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://127.0.0.1:5173"]

# Server Port & Concurrency
PORT=8000
WEB_CONCURRENCY=2

# Relational Database (Neon PostgreSQL Cloud or Local Docker PostgreSQL)
# Example Local: postgresql+asyncpg://legal_admin:legal_secret_pass@localhost:5432/legal_analyzer_db
# Example Neon: postgresql+asyncpg://user:pass@ep-cool-frost-12345.ap-southeast-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://legal_admin:legal_secret_pass@localhost:5432/legal_analyzer_db

# Vector Database (Qdrant Cloud or Local Docker)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=legal_contracts
QDRANT_LEGAL_COLLECTION_NAME=indian_legal_corpus

# Redis / Celery Task Queue (Upstash Cloud or Local Redis)
REDIS_URL=redis://default:your_upstash_password@your-upstash-host:6379

# LLM Providers (OpenAI, Groq, Anthropic, Google Gemini)
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Models Configuration
DEFAULT_FAST_LLM=gpt-4o-mini
DEFAULT_REASONING_LLM=qwen/qwen3.8-27b
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
# 384 for local Sentence Transformers (all-MiniLM-L6-v2), 1536 for OpenAI text-embedding-3-large
EMBEDDING_DIMENSIONS=384

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Cloud Storage (Cloudinary for Contract PDF Permanent Backup)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# JWT Authentication Security Secret
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_characters

# Guest Session Retention
GUEST_CONTRACT_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

