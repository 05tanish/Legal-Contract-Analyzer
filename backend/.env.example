# ==============================================================================
# Legal Contract Analyzer - Production Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Legal Contract Intelligence Platform"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Relational Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://legal_admin:legal_secret_pass@localhost:5432/legal_analyzer_db

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_contracts

# Redis / Celery Task Queue
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Choose one or both)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# LLM Models Configuration
DEFAULT_FAST_LLM=gpt-4o-mini
DEFAULT_REASONING_LLM=claude-3-5-sonnet-20241022
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

