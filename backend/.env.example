# ==============================================================================
# LexAI – Legal Contract Intelligence Platform & Indian Legal Research
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Legal Contract Intelligence Platform"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Relational Database (Neon PostgreSQL Cloud or Local PostgreSQL)
# Note: asyncpg requires 'ssl=require' for Neon Cloud
DATABASE_URL=postgresql+asyncpg://legal_admin:legal_secret_pass@localhost:5432/legal_analyzer_db

# Vector Database (Qdrant Cloud or Local)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=legal_contracts
QDRANT_LEGAL_COLLECTION_NAME=indian_legal_corpus

# Redis / Celery Task Queue (Upstash Cloud or Local Redis)
REDIS_URL=redis://default:your_upstash_password@your-upstash-host:6379

# LLM Providers (OpenAI, Groq, Anthropic)
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=

# LLM Models Configuration
DEFAULT_FAST_LLM=gpt-4o-mini
DEFAULT_REASONING_LLM=qwen/qwen3.8-27b
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
# 384 for local Sentence Transformers (all-MiniLM-L6-v2), 1536 for OpenAI text-embedding-3-large
EMBEDDING_DIMENSIONS=384

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
